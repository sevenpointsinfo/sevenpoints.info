---
layout: null
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9" xmlns:xhtml="http://www.w3.org/1999/xhtml">
{%- assign langs = "en,ar,ckb" | split: "," %}
{%- for l in langs %}
  <url>
    <loc>{{ site.url }}/{% if l != "en" %}{{ l }}/{% endif %}</loc>
    <lastmod>{{ site.time | date: "%Y-%m-%d" }}</lastmod>
    <changefreq>monthly</changefreq>
    <priority>{% if l == "en" %}1.0{% else %}0.9{% endif %}</priority>
    <xhtml:link rel="alternate" hreflang="en" href="{{ site.url }}/"/>
    <xhtml:link rel="alternate" hreflang="ar" href="{{ site.url }}/ar/"/>
    <xhtml:link rel="alternate" hreflang="ckb" href="{{ site.url }}/ckb/"/>
    <xhtml:link rel="alternate" hreflang="x-default" href="{{ site.url }}/"/>
  </url>
{%- endfor %}
</urlset>
